# Local defaults; compose overrides data paths/storage. No real secrets committed.
BROLL_DATA_DIR=data
BROLL_DATABASE=data/jobs.sqlite3
BROLL_MAX_UPLOAD_BYTES=83886080
BROLL_MAX_AUDIO_SECONDS=600
BROLL_MAX_SCRIPT_CHARS=30000
BROLL_MAX_SCENES=150
BROLL_HTTP_TIMEOUT_SECONDS=30
BROLL_WORKER_POLL_SECONDS=0.5
BROLL_LEASE_SECONDS=300
BROLL_MAX_ATTEMPTS=2
BROLL_STORAGE=local
BROLL_PUBLIC_BASE_URL=http://localhost:8000
BROLL_S3_ENDPOINT=http://minio:9000
BROLL_S3_PUBLIC_ENDPOINT=http://localhost:9000
BROLL_S3_ACCESS_KEY=change-local-access-key
BROLL_S3_SECRET_KEY=change-local-secret-at-least-16-chars
BROLL_S3_BUCKET=broll
BROLL_S3_REGION=us-east-1
BROLL_SIGNED_URL_SECONDS=3600
BROLL_API_TOKEN=
BROLL_MAX_QUEUED_JOBS=100
BROLL_ALLOWED_DOWNLOAD_HOSTS=[]
BROLL_FFMPEG=ffmpeg
BROLL_FFPROBE=ffprobe
BROLL_RENDER_TIMEOUT_SECONDS=1800
BROLL_CATALOG=data/catalog.json
BROLL_TTS_PROVIDER=disabled
BROLL_STT_PROVIDER=disabled
BROLL_AI_BASE_URL=https://api.openai.com/v1
BROLL_AI_API_KEY=
BROLL_TTS_MODEL=tts-1
BROLL_TTS_VOICE=alloy
BROLL_STT_MODEL=whisper-1
BROLL_SEED=42
BROLL_OUTPUT_FPS=30
BROLL_LANDSCAPE_WIDTH=1920
BROLL_LANDSCAPE_HEIGHT=1080
BROLL_PORTRAIT_WIDTH=1080
BROLL_PORTRAIT_HEIGHT=1920
BROLL_SQUARE_SIZE=1080
# Optional numerical cost rates: omit when unknown (not zero).
# BROLL_COMPUTE_USD_PER_HOUR=
# BROLL_TTS_USD_PER_MILLION_CHARS=
# BROLL_STT_USD_PER_MINUTE=
